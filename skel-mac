#!/bin/bash
#
# The short form of the line for the Unity skeleton, on macOS:
#
#   /bin/bash -c "$(curl -fsSL https://super-banana-studios.github.io/skel-mac)"
#
# The project this sets up is named here rather than on the command line, so the line carries no
# arguments. setup.sh next to this file is the generic half and takes the repository as an
# argument; one more file like this one is all a second project needs.
#
# Not `curl ... | bash`: that makes the pipe the script's standard input, and the sign-ins below
# read from it - gh and claude would both see end of file instead of the keyboard. The starter is
# written to a file and run from there, which leaves standard input the terminal it came from.

set -u

starter=$(mktemp -t superb-setup) || {
	printf '\nThis machine would not give a temporary file to work in.\nAsk Ivan Murashka (@imurashka).\n' >&2
	exit 1
}
trap 'rm -f "$starter"' EXIT

if ! curl -fsSL https://super-banana-studios.github.io/setup.sh -o "$starter"; then
	printf '\nThe setup script could not be downloaded. Check that you are online, then run the line again.\nAsk Ivan Murashka (@imurashka).\n' >&2
	exit 1
fi

checkout_file="${TMPDIR:-/tmp}"
checkout_file="${checkout_file%/}/superb-setup.checkout"
rm -f "$checkout_file"

/bin/bash "$starter" Super-Banana-Studios/unity-skeleton || exit

# The project's setup script writes the folder of the checkout into that file when it finishes.
# A script cannot move the terminal that started it, and people new to a terminal type `claude`
# right after the run, wherever the window is (Ivan, 2026-09-25) - so the run ends in a fresh
# shell inside the checkout, which also reads the PATH the run wrote into the shell profile.
# `exit` in it returns to the old shell and folder.
checkout=$(head -1 "$checkout_file" 2>/dev/null)
if [ -t 0 ] && [ -n "$checkout" ] && cd "$checkout" 2>/dev/null; then
	rm -f "$starter"
	printf '\nThis window is now in %s - type claude to start.\n' "$checkout"
	exec "${SHELL:-/bin/zsh}" -l
fi
